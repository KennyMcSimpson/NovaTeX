# ============================================================
# NovaTeX Configuration (.env)
# Copy to .env and fill in your values. Never commit .env!
# ============================================================

# Server binding (single port for HTTP API + WebSocket Yjs + SPA)
PORT=3456
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3456

# Persistent storage root (SQLite DB + Git project workspaces + compile cache)
DATA_DIR=./.local-data

# Session signing secret (auto-generated into DATA_DIR/.session-secret if omitted)
SESSION_SECRET=

# Security: keep public registration CLOSED on public servers!
# Registration is strictly controlled by this server-side env var (never toggleable from web UI).
# First user is created via setup wizard or ADMIN_USERNAME/ADMIN_PASSWORD below;
# teammates join via invite links generated inside NovaTeX.
ALLOW_PUBLIC_REGISTER=false
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Feature mode: false (default local-first solo/AI studio) | true (enable multi-user invite links & comments UI)
ENABLE_COLLAB=false

# Compiler mode: "local" (embedded) | "remote" (isolated worker HTTP microservice)
COMPILER_MODE=local
COMPILER_URL=http://127.0.0.1:3457
COMPILER_SHARED_SECRET=
COMPILE_TIMEOUT_MS=60000
COMPILE_MAX_CONCURRENCY=1

# Optional explicit tool paths (auto-detected from PATH and .local-tools/TinyTeX)
TEX_BIN_DIR=
PANDOC_BIN=
QPDF_BIN=

# AI Fixer & Format Polisher (DeepSeek default, OpenAI-compatible)
# Strictly scoped to compile error repair & LaTeX formatting cleanup.
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_REASONER_MODEL=deepseek-reasoner
AI_TIMEOUT_MS=45000
